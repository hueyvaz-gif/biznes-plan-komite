# ── Model ──────────────────────────────────────────────────────────────────
# Format: "<provayder>:<model>"  (init_chat_model üçün)
LLM_MODEL=anthropic:claude-sonnet-5
# Anthropic istifadə edilirsə:
ANTHROPIC_API_KEY=
# Google Gemini istifadə edilirsə (LLM_MODEL=google_genai:gemini-2.5-pro):
GOOGLE_API_KEY=

# ── LangSmith izləmə ───────────────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=biznes-plan-komite

# ── Uyğunluq agenti ────────────────────────────────────────────────────────
# Boş buraxılsa bütün qruplar yoxlanılır. Nümunə: xulase,maliyye,swot
COMPLIANCE_GROUPS=
COMPLIANCE_CONCURRENCY=4

# ── İnkişaf rejimi ─────────────────────────────────────────────────────────
# 1 olanda yükləmə ekranında "süni xəta" seçimi görünür (retry-ni sınamaq üçün).
DEV_MODE=

# ── AI köməkçi (chat) ──────────────────────────────────────────────────────
# Yuxarıdakı LLM_MODEL və onun açarı istifadə olunur — ayrıca açar lazım deyil.
# Açar yoxdursa panel "AI köməkçi qoşulmayıb" yazır. Açar heç vaxt brauzerə getmir.
CHAT_TIMEOUT=60
CHAT_CONCURRENCY=2

# ── Bazar icmalı ───────────────────────────────────────────────────────────
# Valyuta (USD/EUR/TRY → AZN) və qızıl: AR Mərkəzi Bankının açıq bülleteni — açar lazım deyil.
# AAPL, Brent və maliyyə xəbərləri: Alpha Vantage pulsuz açarı
# (https://www.alphavantage.co/support/#api-key). Boşdursa bu hissələr "Mənbə qoşulmayıb" göstərir.
ALPHAVANTAGE_API_KEY=
# 0 — bazar bloku tam söndürülür (xarici sorğu getmir).
MARKET_ENABLED=1
MARKET_TIMEOUT=6

# ── İqtisadi təhlil ───────────────────────────────────────────────────────
# 1 — yoxlama bitəndən sonra avtomatik (bir əlavə model çağırışı); 0 — yalnız "İqtisadi təhlil" tabındakı düymə ilə.
# Benchmark-lar: config/benchmarks/gubre.yaml (mənbəsi və tarixi olmayan sətir istifadə olunmur).
ECONOMICS_AUTO=1

# ── Semantik yaddaş (embeddings) ───────────────────────────────────────────
# GOOGLE_API_KEY varsa Gemini embeddings (çoxdilli, semantik) istifadə olunur — yuxarıdakı GOOGLE_API_KEY.
# Açar yoxdursa avtomatik lokal leksik rejim (model yükləmir, açar tələb etmir, semantik deyil).
# auto | google | lexical
EMBEDDINGS_PROVIDER=auto
EMBEDDINGS_MODEL=models/gemini-embedding-001
EMBEDDINGS_DIMS=768
